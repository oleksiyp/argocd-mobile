# ArgoCD Server Configuration
# Copy this file to .env.local and update with your values

# ArgoCD server URL (without /api/v1 suffix)
# Example: https://argocd.example.com or http://localhost:8080
NEXT_PUBLIC_ARGOCD_SERVER=https://argocd.example.com

# ArgoCD authentication token
# Get token with: argocd account generate-token
# Or from the ArgoCD UI: Settings > Accounts > Generate Token
NEXT_PUBLIC_ARGOCD_TOKEN=your-argocd-token-here

# Use mock data for development (true/false)
# Set to true to use mock data, false to use real ArgoCD API
NEXT_PUBLIC_USE_MOCK_DATA=false

# Use proxy API route (true/false)
# Recommended: true (proxies requests through Next.js API to avoid CORS)
# Set to false only if your ArgoCD server has CORS enabled for your domain
NEXT_PUBLIC_USE_PROXY=true

# Optional: Enable insecure mode for self-signed certificates (development only)
# NEXT_PUBLIC_INSECURE=false
